# Demo: no keys required — PayPal faked, captions from fixtures
NEXT_PUBLIC_DEMO_MODE=true

# Infrastructure flags
ENABLE_PAYPAL=false
ENABLE_OPENAI=false
ENABLE_FFMPEG=false
ENABLE_HD_EXPORT=true

# AI editing — set any to false to hide that feature (no half-UI)
ENABLE_AUTO_CAPTIONS=true
ENABLE_KARAOKE_CAPTIONS=true
ENABLE_CAPTION_EMOJIS=true
ENABLE_HASHTAG_SUGGESTIONS=true
ENABLE_MULTILANG_SUBTITLES=true
ENABLE_BROLL_UNDER_FACE=true
ENABLE_STOCK_BROLL=true
ENABLE_GIF_INSERTS=true
ENABLE_AI_HOOKS=true
ENABLE_SCRIPT_REWRITE=true
ENABLE_CTA_LINES=true
ENABLE_END_CARD_CTA=true
ENABLE_TRIM_SILENCE=true
ENABLE_FILLER_WORD_REMOVAL=true
ENABLE_VOICE_DENOISE=true
ENABLE_AUDIO_NORMALIZE=true
ENABLE_REELS_PRESET=true
ENABLE_TIKTOK_PRESET=true
ENABLE_SHORTS_PRESET=true
ENABLE_LINKEDIN_SQUARE_PRESET=true
ENABLE_YOUTUBE_LANDSCAPE_PRESET=true
ENABLE_SMART_REFRAME=true
ENABLE_BACKGROUND_BLUR=true
ENABLE_BACKGROUND_REMOVE=true
ENABLE_AUTO_CHAPTERS=true
ENABLE_VIRAL_MOMENTS=true
ENABLE_BEAT_SYNC_MARKERS=true
ENABLE_PUNCH_IN_ZOOM=true
ENABLE_COLOR_GRADE_LUT=true
ENABLE_LOWER_THIRDS=true
ENABLE_BRAND_TEMPLATE=true
ENABLE_AUTO_THUMBNAIL=true
ENABLE_INTRO_OUTRO_BUMPER=true

# PayPal Sandbox (Orders v2) — when DEMO_MODE=false and ENABLE_PAYPAL=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# OpenAI — when ENABLE_OPENAI=true
OPENAI_API_KEY=

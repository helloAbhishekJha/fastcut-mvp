# Demo: no keys required — PayPal faked, captions from fixtures
NEXT_PUBLIC_DEMO_MODE=true

# Core feature flags (set false to disable buggy or optional paths)
ENABLE_PAYPAL=false
ENABLE_OPENAI=false
ENABLE_FFMPEG=false
ENABLE_HD_EXPORT=true

# AI editing features (toggle off individually when testing)
ENABLE_AUTO_CAPTIONS=true
ENABLE_CAPTION_EMOJIS=true
ENABLE_BROLL_UNDER_FACE=true
ENABLE_AI_HOOKS=true
ENABLE_TRIM_SILENCE=true
ENABLE_REELS_PRESET=true

# PayPal Sandbox (Orders v2) — required when DEMO_MODE=false and ENABLE_PAYPAL=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# OpenAI — optional captions/hooks when ENABLE_OPENAI=true
OPENAI_API_KEY=
